# ==========================================
# 智维先知 LangGraph版 — 环境变量配置
# ==========================================
# 这是模板文件，不含任何密钥。首次使用请复制为 .env：
#   cp .env.example .env
# 只有 DEEPSEEK_API_KEY 需要自行填写；留空也能跑（自动降级为本地/规则模式）
# 注意：修改此文件后需重启程序

# --- Ollama 配置（企业版：3个专用模型 + 1个嵌入模型） ---
OLLAMA_BASE_URL=http://localhost:11434

# 旧demo系统使用的通用模型（学习版用）
OLLAMA_MODEL=qwen2.5:7b

# 企业版：7个Agent的模型路由
# 本地负责：Monitor/Knowledge/Reflection（轻量、低延迟）
# 注意：这里填的模型名必须已通过 `ollama pull <name>` 拉取到本地，
#       否则 Agent 会在首次调用时报 404。当前本地可用：qwen2.5:7b（对话）/ bge-m3（嵌入）。
#       若后续创建了 Modelfile 定制角色模型（zhiwei-monitor 等），再改回对应名字即可。
OLLAMA_MONITOR_MODEL=qwen2.5:7b
OLLAMA_KNOWLEDGE_MODEL=qwen2.5:7b
OLLAMA_REFLECTION_MODEL=qwen2.5:7b

# 嵌入模型（向量检索用）
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- DeepSeek API 配置（企业版：Diagnostic/Prediction/Decision/Report/聊天意图识别） ---
# 填入你的 API Key 后启用云端推理；留空时系统自动降级为本地/规则模式（不会崩溃）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 系统配置 ---
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# 并行分析的最大设备数
MAX_PARALLEL_DEVICES=15
# 自主监控循环开关：1=开启（每30秒自动扫描，会消耗token），0=关闭（仅手动触发）
AUTONOMOUS_LOOP_ENABLED=0

# 实时数据推进开关：1=按仿真时钟持续追加新读数，0=静态数据集
REALTIME_ENABLED=0
# 仿真时钟步长（分钟）与真实推进间隔（秒）：每 tick_seconds 秒推进 step_minutes 分钟的仿真时间
REALTIME_STEP_MINUTES=30
REALTIME_TICK_SECONDS=5.0

# --- 数据路径 ---
# 数据文件所在目录
DATA_DIR=data/raw

# --- 数据库 ---
DATABASE_URL=sqlite:///./data/zhiwei.db

# --- 认证与权限（JWT 登录 + 三角色 admin/operator/viewer）---
# JWT 签名密钥：必须配置为足够长的随机值（勿使用默认值上线）。生成方式：
#   python -c "import os; print(os.urandom(32).hex())"
# 未配置时服务使用进程级临时密钥（可登录，但重启后全部 token 失效）
AUTH_SECRET=
# 令牌有效期（分钟），默认 720（12 小时）
JWT_EXPIRE_MINUTES=720
# 首次启动播种的管理员账号（users 表为空时生效；改密码后重启不会重置已建账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
