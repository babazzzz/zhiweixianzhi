# ---------------------------------------------------------
# 以下为开源发布补充规则（体积 / 隐私 / 可再生成产物）
# ---------------------------------------------------------

# 本地大模型权重（Ollama，约 6.5G）
models/

# 前端依赖与构建产物
node_modules/
web/dist/
dist/

# 数据库与检索索引：均由脚本可复现生成
*.db
*.db-wal
*.db-shm
data/chroma_db/
data/index/
data/logs/
data/sim_clock.json

# 个人隐私产物（简历 / 证件照 / 参考 PDF）
outputs/

# 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 临时调试文件
_te.txt
_to.txt
error_screenshot.png

# 构建缓存
*.tsbuildinfo

# Vite 从 tailwind.config.ts 自动生成的转译产物（勿跟踪）
web/tailwind.config.js
web/tailwind.config.d.ts

# 课程/个人文档（含姓名学号等隐私，不入库）
*.docx
*.html

# 个人音视频材料压缩包（系统介绍视频与截图等，不入库）
*.zip

# 文档本地备份（README.md.bak / 项目详细报告.md.bak 等，勿提交）
*.bak

# 数据库本地备份（可由当前库复现，勿提交）
data/zhiwei.db.bak*

# 其他临时调试产物
.tmp_*

# ---------------------------------------------------------
# 个人隐私：含姓名 / 学号 / 班级的课程材料与简历
# ---------------------------------------------------------

# 课程项目日志（文件名含真实姓名与学号）
/姓名_学号_班级_项目日志*.xlsx
/钟祥健_*.xlsx
/项目日志_已填充.xlsx
/~$*
~$*

# 简历与个人证件材料
*.pdf

# WorkBuddy 项目数据（含工作记忆，不公开）
.workbuddy/
